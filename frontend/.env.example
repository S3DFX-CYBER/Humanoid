# Base URL of the Humanoid API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase auth (required unless you enable dev mode below)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development only: skip the sign-in screen and rely on the API's
# DEV_AUTH_USER_ID bypass. Never enable this in a deployed build.
NEXT_PUBLIC_DEV_MODE=true
