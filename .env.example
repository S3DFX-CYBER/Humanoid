# ── Database ─────────────────────────────────────────────────
# The app connects as a non-owner role so Row-Level Security applies.
# Migrations and seeds run as the owner (humanoid).
DATABASE_URL=postgresql://humanoid_app:humanoid_app@localhost:5432/humanoid

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Local development only: every request is treated as this user.
# Leave blank (or set ENVIRONMENT=production) to require real JWTs.
DEV_AUTH_USER_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
DEV_AUTH_USER_EMAIL=dev@humanoid.local

# ── LLM Providers ────────────────────────────────────────────
# At least one is required. Gemini handles drafting, OpenAI handles the
# cheap verification/style passes.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Serve placeholder text when no provider is configured. Local UI work only.
ALLOW_STUB_PROVIDER=false

# ── Internal services ────────────────────────────────────────
RENDER_SERVICE_URL=http://localhost:8002
INGESTION_SERVICE_URL=http://localhost:8001

# ── App ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
